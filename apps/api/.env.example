# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://wallet:wallet-dev-only@localhost:5432/wallet
PORT=4000

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# openssl rand -base64 24
OTP_PEPPER=change-me-random-16+

CORS_ORIGIN=*
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

# Sandbox: OTPs are only logged (SMS_PROVIDER=console). Must be false in production.
SANDBOX=true
# Return OTP in API responses so you can demo without SMS. Never true in production.
SANDBOX_EXPOSE_OTP=true
# Approve KYC immediately (otherwise use POST /v1/sandbox/kyc/decide).
KYC_AUTO_APPROVE=false

# Satang. 5000000 = ฿50,000/day
DAILY_LIMIT=5000000
PAYOUT_FEE=0

# GO Along operator token for /v1/admin/orgs (onboard a factory). openssl rand -hex 24
ADMIN_TOKEN=change-me-admin-token-at-least-24-chars
# LINE Login channel id (verifies LIFF id tokens). Empty in local dev: accepts "sandbox:<id>" tokens.
LINE_CHANNEL_ID=
# LINE Messaging API channel access token (same Provider as the Login channel): payment receipts to employees. Empty = no receipts.
LINE_MESSAGING_TOKEN=
# Hours after a purchase that the shop may still refund it
REFUND_WINDOW_HOURS=24
CHARGE_TTL_SEC=180
# Legacy consumer P2P wallet routes (self-register, KYC, bank payout). Keep false for the canteen product.
CONSUMER_WALLET=false
SMS_PROVIDER=console
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
THAIBULKSMS_SENDER=
