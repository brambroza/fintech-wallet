# Copy to deploy/.env.prod on the VM (chmod 600). Never commit the real file.
REGISTRY=registry.goalong.co.th
TAG=latest
API_DOMAIN=api.canteen.example.co.th
APP_DOMAIN=canteen.example.co.th

# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 24
OTP_PEPPER=
# GO Along operator token for /v1/admin/orgs (onboard a factory). openssl rand -hex 24
ADMIN_TOKEN=

SANDBOX=false
SANDBOX_EXPOSE_OTP=false
CONSUMER_WALLET=false

SMS_PROVIDER=thaibulksms
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
# Registered sender name (trial accounts: Demo)
THAIBULKSMS_SENDER=

# LINE Login channel id (LIFF id tokens are verified against it)
LINE_CHANNEL_ID=
# LINE Messaging API channel access token (same Provider as the Login channel): payment receipts to employees. Empty = no receipts.
LINE_MESSAGING_TOKEN=
# Hours after a purchase that the shop may still refund it
REFUND_WINDOW_HOURS=24

ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
CHARGE_TTL_SEC=180
